{
  "name": "@solteq-excom/medusa-payment-paytrail",
  "version": "1.0.11",
  "description": "Paytrail payment provider plugin for Medusa",
  "keywords": [
    "medusa-plugin-payment",
    "medusa-plugin-integration",
    "medusa-v2",
    "paytrail",
    "payment"
  ],
  "author": "Solteq",
  "license": "MIT",
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build",
    "develop": "medusa plugin:develop",
    "publish:local": "medusa plugin:publish",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@paytrail/paytrail-js-sdk": "^2.0.0",
    "class-transformer": "^0.5.1"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.13.3",
    "@medusajs/cli": "^2.13.3",
    "@medusajs/framework": "^2.13.3",
    "@medusajs/medusa": "^2.13.3",
    "@medusajs/test-utils": "^2.13.3",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.13.3",
    "@medusajs/cli": "^2.13.3",
    "@medusajs/framework": "^2.13.3",
    "@medusajs/medusa": "^2.13.3",
    "@medusajs/test-utils": "^2.13.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610",
  "publishConfig": {
    "access": "public"
  }
}
